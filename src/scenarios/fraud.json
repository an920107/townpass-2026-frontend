    },
    {
      "id": "like",
      "type": "tap",
      "target": "like",
      "hint": "請點亮起來的讚喔！",
      "tip": "看完了嗎？覺得有幫助就按個讚。",
      "resultTip": "這是 AI 的判斷"
    },
    {
      "id": "done",
      "type": "done",
      "title": "您學會請 AI 看可疑訊息了！",
      "points": [
        "截圖傳給 AI",
        "不要點可疑連結",
        "不確定就打 165"
      ]
